# PostgreSQL. Ex.: postgresql://USUARIO:SENHA@localhost:5432/lumina
# Em desenvolvimento local: pnpm db:dev sobe um Postgres nessa URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumina"

# Segredo para assinar a sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
